    <!-- Adb -->
    <string name="dialog_adb_discovery">Recherche du service de débogage sans fil</string>
    <string name="dialog_adb_discovery_message">Veuillez activer le \"Débogage sans fil\" dans les \"Options pour les développeurs\". Le débogage sans fil se désactive automatiquement lors des changements de réseau.\n\nNote : ne désactivez pas les \"Options développeurs\" ou le \"Débogage USB\", sinon JWSK s\'arrêtera.</string>
    <string name="dialog_adb_discovery_message_toggle_wireless_debugging">Veuillez désactiver et réactiver le \"Débogage sans fil\" si la recherche persiste.</string>
    <string name="dialog_adb_port">Port</string>
    <string name="dialog_adb_invalid_port">Le port doit être un entier compris entre 1 et 65535.</string>
    <string name="adb_pairing">Association</string>
    <string name="dialog_adb_pairing_title">Associer avec l\'appareil</string>
    <string name="dialog_adb_pairing_discovery">Recherche du service d\'association</string>
    <string name="dialog_adb_pairing_paring_code">Code d\'association</string>
    <string name="paring_code_is_wrong">Le code d\'association est incorrect.</string>
    <string name="cannot_connect_port">Impossible de se connecter au service de débogage sans fil.</string>
    <string name="dialog_wireless_adb_not_enabled">Le débogage sans fil n\'est pas activé.\nNote : avant Android 11, une connexion à un ordinateur est obligatoire.</string>
    <string name="dialog_adb_pairing_message">Démarrez l\'association en suivant ces étapes : \"Options développeurs\" - \"Débogage sans fil\" - \"Associer l\'appareil avec un code d\'association\".\n\nUne fois le processus lancé, vous pourrez saisir le code.</string>
    <string name="adb_pairing_requires_multi_window">Veuillez d\'abord passer en mode écran partagé (multi-fenêtres).</string>
    <string name="adb_pairing_requires_multi_window_reason">Le système exige que la boîte de dialogue d\'association soit toujours visible. L\'écran partagé est le seul moyen de garder l\'application et la boîte système visibles en même temps.</string>
    <string name="adb_error_key_store">Impossible de générer la clé de débogage sans fil.\nCela peut être dû à un dysfonctionnement du KeyStore de cet appareil.</string>
    <string name="adb_pair_required">Veuillez d\'abord effectuer l\'étape d\'association.</string>
    <string name="development_settings">Options pour les développeurs</string>
    <string name="notification_settings">Options de notification</string>
    <string name="adb_pairing_tutorial_title">Associer JWSK à votre appareil</string>
    <string name="adb_pairing_tutorial_content_notification">Une notification de JWSK vous aidera à finaliser l\'association.</string>
    <string name="adb_pairing_tutorial_content_steps">Allez dans \"Options développeurs\" - \"Débogage sans fil\". Appuyez sur \"Associer l\'appareil avec un code d\'association\", un code à six chiffres s\'affichera.</string>
    <string name="adb_pairing_tutorial_content_enter_pairing_code">Saisissez le code dans la notification pour terminer l\'association.</string>
    <string name="adb_pairing_tutorial_content_notification_blocked">Le processus d\'association nécessite d\'interagir avec une notification de JWSK. Veuillez autoriser JWSK à envoyer des notifications.</string>
    <string name="adb_pairing_tutorial_content_miui">Les utilisateurs de MIUI doivent régler le style de notification sur \"Android\" dans \"Paramètres\" - \"Notifications\".</string>
    <string name="adb_pairing_tutorial_content_miui_2">Sinon, vous ne pourrez pas saisir le code depuis la notification.</string>
    <string name="adb_pairing_tutorial_content_left_is_clickable">Remarque : la partie gauche de l\'option \"Débogage sans fil\" est cliquable et ouvre une nouvelle page. Activer uniquement l\'interrupteur de droite ne suffit pas.</string>
    <string name="adb_pairing_tutorial_content_finish">Revenez sur JWSK et lancez le service.</string>
    <string name="adb_pairing_tutorial_content_network">JWSK nécessite l\'accès au réseau local.</string>
    <string name="adb_pairing_tutorial_content_network_limation_not_foreground">Certains systèmes (comme MIUI) bloquent l\'accès au réseau en arrière-plan. Désactivez l\'optimisation de la batterie pour JWSK.</string>

