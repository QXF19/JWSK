    <!-- Adb -->
    <string name="dialog_adb_discovery">Buscando servicio de depuración inalámbrica</string>
    <string name="dialog_adb_discovery_message">Por favor active \"Depuración inalámbrica\" en \"Opciones de desarrollador\". La depuración inalámbrica se desactiva automáticamente al cambiar de red.\n\nNota: no desactive \"Opciones de desarrollador\" ni \"Depuración por USB\", o JWSK se detendrá.</string>
    <string name="dialog_adb_discovery_message_toggle_wireless_debugging">Por favor intente desactivar y volver a activar \"Depuración inalámbrica\" si la búsqueda continúa.</string>
    <string name="dialog_adb_port">Puerto</string>
    <string name="dialog_adb_invalid_port">El puerto debe ser un número entero entre 1 y 65535.</string>
    <string name="adb_pairing">Emparejamiento</string>
    <string name="dialog_adb_pairing_title">Emparejar con el dispositivo</string>
    <string name="dialog_adb_pairing_discovery">Buscando servicio de emparejamiento</string>
    <string name="dialog_adb_pairing_paring_code">Código de emparejamiento</string>
    <string name="paring_code_is_wrong">El código de emparejamiento es incorrecto.</string>
    <string name="cannot_connect_port">No se pudo conectar al servicio de depuración inalámbrica.</string>
    <string name="dialog_wireless_adb_not_enabled">La depuración inalámbrica no está activada.\nNota: antes de Android 11, se requiere conexión a un ordenador para activarla.</string>
    <string name="dialog_adb_pairing_message">Inicie el emparejamiento siguiendo estos pasos: \"Opciones de desarrollador\" - \"Depuración inalámbrica\" - \"Emparejar dispositivo con código de emparejamiento\".\n\nUna vez iniciado, podrá introducir el código.</string>
    <string name="adb_pairing_requires_multi_window">Por favor active primero el modo de pantalla dividida (multiventana).</string>
    <string name="adb_pairing_requires_multi_window_reason">El sistema requiere que el diálogo de emparejamiento esté visible en todo momento. Usar pantalla dividida es la única forma de mantener visibles esta app y el diálogo del sistema simultáneamente.</string>
    <string name="adb_error_key_store">No se pudo generar la clave de depuración inalámbrica.\nEsto puede deberse a que el almacén de claves (KeyStore) de este dispositivo esté dañado.</string>
    <string name="adb_pair_required">Por favor complete primero el paso de emparejamiento.</string>
    <string name="development_settings">Opciones de desarrollador</string>
    <string name="notification_settings">Opciones de notificación</string>
    <string name="adb_pairing_tutorial_title">Emparejar JWSK con su dispositivo</string>
    <string name="adb_pairing_tutorial_content_notification">Una notificación de JWSK le ayudará a completar el emparejamiento.</string>
    <string name="adb_pairing_tutorial_content_steps">Vaya a \"Opciones de desarrollador\" - \"Depuración inalámbrica\". Toque \"Emparejar dispositivo con código de emparejamiento\", verá un código de seis dígitos.</string>
    <string name="adb_pairing_tutorial_content_enter_pairing_code">Introduzca el código en la notificación para completar el emparejamiento.</string>
    <string name="adb_pairing_tutorial_content_notification_blocked">El emparejamiento requiere interactuar con una notificación de JWSK. Por favor permita que JWSK envíe notificaciones.</string>
    <string name="adb_pairing_tutorial_content_miui">Los usuarios de MIUI pueden necesitar cambiar el estilo de notificación a \"Android\" en \"Ajustes\" - \"Notificaciones\" - \"Barra de notificaciones\".</string>
    <string name="adb_pairing_tutorial_content_miui_2">De lo contrario, no podrá introducir el código de emparejamiento desde la notificación.</string>
    <string name="adb_pairing_tutorial_content_left_is_clickable">Tenga en cuenta que la parte izquierda de \"Depuración inalámbrica\" es pulsable y abre una nueva página. Activar solo el interruptor de la derecha no es suficiente.</string>
    <string name="adb_pairing_tutorial_content_finish">Vuelva a JWSK e inicie el servicio.</string>
    <string name="adb_pairing_tutorial_content_network">JWSK necesita acceder a la red local. Esto se controla mediante el permiso de red.</string>
    <string name="adb_pairing_tutorial_content_network_limation_not_foreground">Algunos sistemas (como MIUI) restringen el acceso a red cuando las apps no están visibles, aunque usen servicios en primer plano. Desactive las optimizaciones de batería para JWSK.</string>

